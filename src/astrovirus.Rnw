\subsection*{Who are the main submitters of sequence data?}


<<fig.width=8, fig.height=6>>=
top_x_author_table(
  data=data,
  top_x=25,
  authors="authors"
)
@

<<fig.width=8, fig.height=6>>=
top_x_author_table(
  data=data,
  top_x=25,
  authors="host"
)
@

<<eval=FALSE>>=
library(taxize)

unique_hosts <- data %>%
  subset(host!="NA") %>%
  subset(!is.na(host)) %>%
  select(host) %>%
  unique(.)

#db_download_ncbi()

taxids <- taxize::get_uid(unique_hosts$host)
unique_hosts$taxids = taxids

#lineages <- classification(taxids, db = "ncbi")

# Fetch the class name
class_result <- tax_name(sci = taxids, get = "class", db = "ncbi")

# View the result
print(class_result$class)

unique_hosts$scientific_name <- classification(
  sci_id = unique_hosts$taxids,
  get = "genus",
  db = "ncbi"
)

unique_hosts$scientific_name <- sapply(
  unique_hosts$taxids,
  function(x) {
    classification(x, db = "ncbi")[[1]]$name[1]
  }
)
@

\newpage

\subsection*{What is the host/composition in each cluster?}

<<>>=
host_table <- data %>%
  count(major_cluster, host, name = "n") %>%
  group_by(major_cluster) %>%
  arrange(desc(n), host) %>%
  summarise(
    cluster_size = sum(n),
    hosts = paste(host, collapse = ", "),
    .groups = "drop"
  ) %>%
  arrange(desc(cluster_size))

write_delim(host_table, "cluster_host_table.tsv", delim="\t")

host_table %>% subset(!is.na(major_cluster) & cluster_size>2) %>% kable
@


